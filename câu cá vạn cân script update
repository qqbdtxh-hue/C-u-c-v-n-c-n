local function TeleportToNPC(name)
    local cframe = npcPositions[name]
    if not cframe then 
        Rayfield:Notify({Title = "Lỗi", Content = "Không tìm thấy tọa độ của: " .. name, Duration = 3})
        return 
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = cframe
        Rayfield:Notify({Title = "Dịch Chuyển", Content = "Đã đến: " .. name, Duration = 3})
    end
end

-- =============================================
-- AUTO ROD
-- =============================================
local function StartAutoRod()
    if AutoRodLoop then return end
    AutoRodLoop = task.spawn(function()
        while AutoRodEnabled do
            Event.PullFishEvent:FireServer(65, 200)
            task.wait(0.1)
        end
    end)
end

local function StopAutoRod()
    AutoRodEnabled = false
    if AutoRodLoop then
        task.cancel(AutoRodLoop)
        AutoRodLoop = nil
    end
end

